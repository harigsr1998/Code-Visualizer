# Normalize line endings: store LF in the repo, check out LF everywhere.
# Keeps Windows and Linux builds identical (ESP-IDF, CMake and shell scripts expect LF).
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf

# Binary files: never touch line endings, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.svgz  binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.xz    binary
*.tar   binary
*.bin   binary
*.elf   binary
*.hex   binary
*.pcap  binary
*.pcapng binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
